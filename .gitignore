node_modules
dist
dist-electron
out
# Ignore compiled native modules in build/ but not source assets (icons, plists, scripts)
build/*.node
.env
*.local
# Playwright run artifacts
test-results
playwright-report
e2e-report
e2e-visual-artifacts
/app-screenshot.png
# Paperclip / Claude Code agent worktrees — never commit nested git repos
.claude/
.paperclip/
# Generated scratch output (e.g. BugHunt-Fisher.sh daily reports) — never source
.tmp/
daily_bug_hunt_*.md
daily_bug_hunt_*.json

# Fidelity harness captures (SKY-9257) — regenerated per run, never source
e2e/fidelity/output/

# SKY-11243 — bundled Kokoro TTS weights are fetched at build time
# (scripts/fetch-kokoro-assets.mjs), never committed. Keep the LICENSE.
electron-main/resources/kokoro/model_*.onnx
electron-main/resources/kokoro/tokenizer.json
electron-main/resources/kokoro/voices/
electron-main/resources/kokoro/wasm/

# SKY-11623 / SKY-11625 — Python bytecode caches are build artifacts, never source
__pycache__/
*.py[cod]

# SKY-11675 — the wallpaper PNG originals are owner-held and stay out of git
# history (68.2 MB). Restage them here to rebuild; PROVENANCE.json next to this
# folder carries the dimensions and SHA-256 that identify each one.
design-assets/wallpapers/originals/
