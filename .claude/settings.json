{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add *)",
      "Bash(git commit *)", "Bash(git checkout -b *)", "Bash(git switch *)",
      "Bash(git push -u origin claude/*)", "Bash(git push origin claude/*)",
      "Bash(npm ci --ignore-scripts*)", "Bash(npm test*)", "Bash(npm run test*)", "Bash(npm run lint*)",
      "Bash(npm run typecheck*)", "Bash(npm run build*)",
      "Bash(npx vitest *)", "Bash(npx tsc *)", "Bash(npx eslint *)", "Bash(rg *)",
      "Bash(gh pr create --draft *)", "Bash(gh pr view *)", "Bash(gh pr checks *)"
    ],
    "deny": [
      "Edit(.claude/settings.json)", "Write(.claude/settings.json)",
      "Edit(.claude/**)", "Write(.claude/**)",
      "Edit(.github/**)", "Write(.github/**)",
      "Read(.env*)", "Edit(.env*)",
      "Read(*.pem)", "Edit(*.pem)",
      "Read(*.key)", "Edit(*.key)",
      "Read(id_*)", "Edit(id_*)",
      "Read(~/.ssh/**)", "Edit(~/.ssh/**)",
      "Read(~/.aws/**)", "Edit(~/.aws/**)",
      "Read(~/.config/gh/**)", "Edit(~/.config/gh/**)",
      "Bash(printenv*)", "Bash(env)", "Bash(env *)", "Bash(cat *.env*)",
      "Bash(git -C *)", "Bash(bash -c *)", "Bash(sh -c *)", "Bash(gh api *)",
      "Bash(gh pr merge*)", "Bash(gh pr ready*)",
      "Bash(git push)", "Bash(git push main*)", "Bash(git push * main*)",
      "Bash(git push origin HEAD*)", "Bash(git push -u origin HEAD*)", "Bash(git push HEAD*)",
      "Bash(git push *:main*)", "Bash(git push *:refs/heads/main*)", "Bash(git push *refs/heads/main*)",
      "Bash(git push *+main*)", "Bash(git push *HEAD:main*)",
      "Bash(git push *master*)", "Bash(git push *refs/heads/master*)", "Bash(git push *:master*)",
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(git push * --force*)", "Bash(git push * -f*)", "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --amend*)", "Bash(git commit * --amend*)"
    ]
  }
}
